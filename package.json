{
  "name": "dev-footprint",
  "version": "3.0.0",
  "description": "Audit developer tool disk usage on macOS — Claude, VS Code, node_modules, Xcode, Python, Git, Docker, Homebrew",
  "type": "module",
  "bin": {
    "dev-footprint": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src/"
  },
  "keywords": [
    "disk-usage",
    "macos",
    "developer-tools",
    "claude",
    "xcode",
    "node-modules",
    "python",
    "docker",
    "homebrew",
    "vscode",
    "ubersicht"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/node": "^25.3.5",
    "knip": "^5.86.0",
    "lefthook": "^2.1.3",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
